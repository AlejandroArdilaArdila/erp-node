{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@erp/shared": ["./libs/shared/src/index.ts"],
      "@erp/shared/cargar-env": ["./libs/shared/src/config/cargar-env.ts"],
      "@erp/database": ["./libs/database/src/index.ts"],
      "@erp/dolibarr": ["./libs/dolibarr/src/index.ts"],
      "@erp/domain/*": ["./libs/domain/src/*/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "libs/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
