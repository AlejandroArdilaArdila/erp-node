# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Cada variable está validada en libs/shared/src/config/env.schema.ts.

NODE_ENV=development          # development | test | production
TZ=America/Bogota             # Misma zona horaria que Dolibarr/MySQL

# HTTP
HOST=127.0.0.1                # Solo local: Apache hace de proxy inverso
PORT=3100
API_PREFIX=api                # Igual que apipos: /api/...
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace

# Documentación /api/docs protegida con usuario y contraseña (HTTP Basic).
# Con SWAGGER_ENABLED=true, la contraseña debe tener al menos 16 caracteres.
# Generar una: openssl rand -base64 24
SWAGGER_ENABLED=true
SWAGGER_USER=equipo
SWAGGER_PASSWORD=

# Base de datos legado (MySQL de Dolibarr). Usar un usuario con los permisos mínimos.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_PREFIX=llx_
LEGACY_DB_POOL_SIZE=10

# $dolibarr_main_instance_unique_id de htdocs/conf/conf.php (cifra/descifra api_key)
DOLIBARR_INSTANCE_KEY=
TENANT_ID=
